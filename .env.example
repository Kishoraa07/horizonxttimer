# ==============================================================================
# HORIZONXT 2026 - ENVIRONMENT CONFIGURATION FOR VERCEL
# 36-Hour Space & Technology Innovation Hackathon (Research • Innovation • Impact)
# Add these variables under your Vercel Project Settings -> Environment Variables
# ==============================================================================

# --- 1. MONGODB DATABASE (For Persistent Multi-Device 36h Timer & Event Photos) ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/horizonxt?retryWrites=true&w=majority
MONGODB_DB=horizonxt

# --- 2. CLOUDINARY CREDENTIALS (For Instant Live Photo CDN Hosting) ---
# Obtain from your Cloudinary Dashboard (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 3. (OPTIONAL) FIXED 36-HOUR MISSION SCHEDULE TIMESTAMPS ---
# HORIZONXT_START_TIME=2026-10-26T09:00:00+05:30
# HORIZONXT_TARGET_END_TIME=2026-10-27T21:00:00+05:30
